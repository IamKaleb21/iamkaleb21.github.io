---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getData } from '../data';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const data = getData('es');

const siteUrl = (import.meta.env.SITE ?? 'https://iamkaleb21.github.io').replace(/\/$/, '');
const canonicalUrl = Astro.url.pathname.startsWith('/')
	? `${siteUrl}${Astro.url.pathname}`.replace(/\/?$/, '/')
	: `${siteUrl}/${Astro.url.pathname}`.replace(/\/?$/, '/');
const ogImage = `${siteUrl}/favicon.svg`;
---

<!doctype html>
<html lang="es" id="html-root">
	<head>
		<meta charset="UTF-8" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="es" href={`${siteUrl}/`} />
		<link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="keywords" content="blog, desarrollador, astro, mdx" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@700&display=swap" rel="stylesheet">

		<title>{title}</title>
	</head>
	<body>
		<a href="#main" class="skip-link">
			{data.ui.skipLink}
		</a>
		<Nav locale="es" ui={data.ui} linkBase="/" isBlogPage />
		<main id="main" class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-16">
			<slot />
		</main>
		<Footer
			githubUrl={data.site.githubUrl}
			linkedinUrl={data.site.socialLinks.linkedin}
			email={data.site.socialLinks.email}
			location={data.site.location}
		/>
	</body>
</html>
