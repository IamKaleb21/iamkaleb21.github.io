---
import type { Experience } from '../data/types';
import ExperienceCard from './ExperienceCard.astro';

interface Props {
	experience: Experience;
	isLeft: boolean;
	isMobile: boolean;
}

const { experience, isLeft, isMobile } = Astro.props;
---

{
	isMobile ? (
		<!-- Mobile: simple timeline item -->
		<div class="relative flex gap-4 pl-5 pb-8 last:pb-0" data-experience-item data-experience-mobile>
			<div class="absolute left-0 top-6 w-3 h-3 rounded-full -translate-x-1/2 z-10 bg-purple-500"></div>
			<div class="flex-1 ml-1">
				<ExperienceCard experience={experience} />
			</div>
		</div>
	) : (
		<!-- Desktop: alternating left/right layout -->
		<div
			class="relative flex flex-col md:flex-row md:items-center min-h-[120px] py-6 md:py-8"
			data-experience-item
			data-experience-side={isLeft ? 'left' : 'right'}
		>
			<!-- Left column: card if isLeft, else empty -->
			<div class="md:w-1/2 md:pr-6 flex md:justify-end">
				{isLeft ? (
					<>
						<ExperienceCard experience={experience} />
						<!-- Horizontal connector (desktop) -->
						<div class="hidden md:flex flex-1 min-w-[24px] items-center">
							<div class="h-0.5 w-full bg-purple-500/60"></div>
						</div>
					</>
				) : (
					<div class="hidden md:block w-full max-w-lg"></div>
				)}
			</div>

			<!-- Center: node (placeholder - will be handled by parent) -->
			<!-- This component intentionally excludes the center node -->
			<!-- The node stays in Experience.astro for proper positioning -->

			<!-- Right column: empty if isLeft, card if !isLeft -->
			<div class="md:w-1/2 md:pl-6 flex md:justify-start">
				{!isLeft ? (
					<>
						<!-- Horizontal connector (desktop) -->
						<div class="hidden md:flex flex-1 min-w-[24px] items-center">
							<div class="h-0.5 w-full bg-purple-500/60"></div>
						</div>
						<ExperienceCard experience={experience} />
					</>
				) : (
					<div class="hidden md:block w-full max-w-lg"></div>
				)}
			</div>
		</div>
	)
}
