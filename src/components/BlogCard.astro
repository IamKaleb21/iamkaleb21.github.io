---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const href = `/blog/${entry.id}/`;
const dateFormatted = new Intl.DateTimeFormat('es-ES', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(entry.data.pubDate);
---

<article class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm p-6 hover:border-white/20 transition-colors">
	<a href={href} class="block group">
		{entry.data.image && (
			<div class="mb-4 rounded-xl overflow-hidden border border-white/5">
				<Image
					src={entry.data.image}
					alt=""
					class="w-full h-48 object-cover group-hover:opacity-95 transition-opacity"
					loading="lazy"
				/>
			</div>
		)}
		<time class="text-sm text-gray-400" datetime={entry.data.pubDate.toISOString()}>
			{dateFormatted}
		</time>
		<h2 class="mt-1 text-xl font-semibold text-white group-hover:text-purple-300 transition-colors">
			{entry.data.title}
		</h2>
		<p class="mt-2 text-gray-400 text-sm line-clamp-2">
			{entry.data.description}
		</p>
	</a>
</article>
