---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
	entry: CollectionEntry<'blog'>;
	authorName?: string;
}

const { entry, authorName } = Astro.props;
const href = `/blog/${entry.id}/`;
const dateFormatted = new Intl.DateTimeFormat('es-ES', {
	day: 'numeric',
	month: 'short',
	year: 'numeric',
}).format(entry.data.pubDate);
const tags = entry.data.tags ?? [];
---

<article
	class="blog-card group relative h-full rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-sm overflow-hidden hover:border-white/20 transition-colors flex flex-col"
	data-date={entry.data.pubDate.valueOf()}
>
	<a href={href} class="flex flex-col flex-1 min-h-0">
		{entry.data.image ? (
			<div class="relative w-full aspect-[16/10] flex-shrink-0 overflow-hidden rounded-t-2xl border-b border-white/5">
				<Image
					src={entry.data.image}
					alt=""
					class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
					loading="lazy"
				/>
			</div>
		) : entry.data.imageUrl ? (
			<div class="relative w-full aspect-[16/10] flex-shrink-0 overflow-hidden rounded-t-2xl border-b border-white/5">
				<img
					src={entry.data.imageUrl}
					alt=""
					class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
					loading="lazy"
				/>
			</div>
		) : (
			<div class="w-full aspect-[16/10] flex-shrink-0 rounded-t-2xl border-b border-white/5 bg-white/5 flex items-center justify-center">
				<Icon name="mdi:notebook-outline" class="w-12 h-12 text-white/20" />
			</div>
		)}
		<div class="p-5 flex flex-col flex-1 min-h-0">
			<div class="flex items-center gap-2 text-sm text-gray-400 mb-2 flex-shrink-0">
				{authorName && <span>{authorName}</span>}
				{authorName && <span aria-hidden="true">·</span>}
				<time datetime={entry.data.pubDate.toISOString()}>{dateFormatted}</time>
			</div>
			<h2 class="text-lg font-semibold text-white group-hover:text-purple-300 transition-colors mb-2 line-clamp-2 min-h-[3.25rem] flex-shrink-0">
				{entry.data.title}
			</h2>
			<p class="text-sm text-gray-400 line-clamp-2 min-h-[2.5rem]">
				{entry.data.description}
			</p>
		</div>
	</a>
	<div class="flex items-end justify-between gap-3 px-5 pb-5 pt-0 flex-shrink-0">
		{tags.length > 0 ? (
			<div class="flex flex-wrap gap-2" aria-label="Etiquetas">
				{tags.slice(0, 3).map((tag) => (
					<span
						class="px-2.5 py-1 rounded-lg text-xs font-medium bg-white/5 text-gray-400 border border-white/5"
					>
						{tag}
					</span>
				))}
			</div>
		) : (
			<span />
		)}
		<a
			href={href}
			class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-full bg-[#8b5cf6] text-white hover:bg-purple-500 transition-colors shadow-lg"
			aria-label="Leer entrada"
		>
			<Icon name="mdi:arrow-top-right" class="w-5 h-5" />
		</a>
	</div>
</article>
