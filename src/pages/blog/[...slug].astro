---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('blog', ({ data }) => data.draft !== true);
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

const { Content } = await render(entry);
const dateFormatted = new Intl.DateTimeFormat('es-ES', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(entry.data.pubDate);
---

<BlogLayout title={entry.data.title} description={entry.data.description}>
	<article class="prose prose-invert prose-headings:text-white prose-p:text-gray-300 prose-a:text-purple-400 max-w-none">
		<header class="mb-8">
			<h1 class="text-3xl font-bold text-white mb-2">{entry.data.title}</h1>
			<time class="text-sm text-gray-400" datetime={entry.data.pubDate.toISOString()}>
				{dateFormatted}
			</time>
			{entry.data.updatedDate && (
				<span class="text-gray-500 text-sm ml-2">
					(actualizado: {new Intl.DateTimeFormat('es-ES', { dateStyle: 'short' }).format(entry.data.updatedDate)})
				</span>
			)}
			{entry.data.image && (
				<div class="mt-4 rounded-xl overflow-hidden border border-white/10">
					<Image
						src={entry.data.image}
						alt=""
						class="w-full max-h-80 object-cover"
						loading="eager"
					/>
				</div>
			)}
		</header>
		<div class="blog-content">
			<Content />
		</div>
	</article>
</BlogLayout>
