---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getData } from '../../data';

const data = getData('es');
const entries = (await getCollection('blog', ({ data: frontmatter }) => frontmatter.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const title = `Blog | ${data.site.name}`;
const description = 'Artículos y notas sobre desarrollo, tecnología y proyectos.';
---

<BlogLayout title={title} description={description}>
	<h1 class="text-3xl font-bold text-white mb-8">Blog</h1>
	{entries.length === 0 ? (
		<p class="text-gray-400">Próximamente habrá entradas aquí.</p>
	) : (
		<ul class="grid gap-8 sm:grid-cols-1 md:grid-cols-2" role="list">
			{entries.map((entry) => (
				<li>
					<BlogCard entry={entry} />
				</li>
			))}
		</ul>
	)}
</BlogLayout>
