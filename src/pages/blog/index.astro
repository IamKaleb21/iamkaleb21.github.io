---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import FeaturedBlogCard from '../../components/FeaturedBlogCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getData } from '../../data';

const data = getData('es');
const entries = (await getCollection('blog', ({ data: frontmatter }) => frontmatter.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featuredEntry = entries[0];
const listEntries = entries.slice(1);
const title = `Blog | ${data.site.name}`;
const description = 'Noticias de desarrollo, series, libros, sucesos y emprendimientos. Un poco de todo.';
const initialCount = 6;
---

<BlogLayout title={title} description={description}>
	<section class="mb-8 pt-2">
		<h2 class="text-3xl sm:text-4xl font-bold text-white mb-3 tracking-tight">
			Un poco de todo
		</h2>
		<p class="text-gray-400 text-lg leading-relaxed">
			Comento noticias de desarrollo, hablo de series, libros, lo que va pasando y lo que voy emprendiendo.
		</p>
	</section>

	{featuredEntry && (
		<section class="mb-12" aria-label="Entrada destacada">
			<FeaturedBlogCard entry={featuredEntry} authorName={data.site.name} />
		</section>
	)}

	{entries.length === 0 ? (
		<section class="py-16 text-center" aria-label="Estado vacío del blog">
			<div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/5 border border-white/10 mb-6" aria-hidden="true">
				<svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
				</svg>
			</div>
			<h2 class="text-xl font-semibold text-white mb-2">Próximamente habrá entradas aquí</h2>
			<p class="text-gray-400 max-w-md mx-auto">
				Estoy preparando artículos sobre desarrollo, series, libros y más. Vuelve en unos días.
			</p>
		</section>
	) : (
		<>
			<header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10">
				<h1 class="text-3xl font-bold text-white">Todos los posts</h1>
				<div class="flex items-center gap-2">
					<label for="blog-sort" class="text-sm text-gray-400 whitespace-nowrap">Ordenar por:</label>
					<select
						id="blog-sort"
						class="blog-sort rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-gray-300 focus:border-purple-500/50 focus:outline-none focus:ring-1 focus:ring-purple-500/50 transition-colors"
						aria-label="Ordenar entradas del blog"
					>
						<option value="newest">Más recientes</option>
						<option value="oldest">Más antiguos</option>
					</select>
				</div>
			</header>
			<ul id="blog-list" class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3" role="list">
				{listEntries.map((entry, i) => (
					<li
						class={`h-full ${i >= initialCount ? 'blog-item-hidden' : ''}`}
						data-date={entry.data.pubDate.valueOf()}
					>
						<BlogCard entry={entry} authorName={data.site.name} />
					</li>
				))}
			</ul>
			{listEntries.length > initialCount && (
				<div class="flex justify-center mt-12">
					<button
						type="button"
						id="blog-load-more"
						class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#8b5cf6] text-white font-medium hover:bg-purple-500 transition-colors"
					>
						Cargar más
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</button>
				</div>
			)}
		</>
	)}
</BlogLayout>

<style is:global>
	.blog-item-hidden {
		display: none;
	}
</style>

<script define:vars={{ initialCount }}>
	document.addEventListener('DOMContentLoaded', () => {
		const list = document.getElementById('blog-list');
		const sortSelect = document.getElementById('blog-sort');
		const loadMoreBtn = document.getElementById('blog-load-more');
		if (!list) return;

		const items = Array.from(list.querySelectorAll('li'));
		const total = items.length;

		function showNextBatch() {
			const hidden = list.querySelectorAll('.blog-item-hidden');
			const toShow = Math.min(6, hidden.length);
			hidden.forEach((el, i) => {
				if (i < toShow) el.classList.remove('blog-item-hidden');
			});
			if (list.querySelectorAll('.blog-item-hidden').length === 0 && loadMoreBtn) {
				loadMoreBtn.style.display = 'none';
			}
		}

		function sortItems(order) {
			items.sort((a, b) => {
				const dateA = Number(a.dataset.date);
				const dateB = Number(b.dataset.date);
				return order === 'newest' ? dateB - dateA : dateA - dateB;
			});
			items.forEach((el) => list.appendChild(el));
			// Re-ocultar los que estaban ocultos (después de initialCount)
			items.forEach((el, i) => {
				if (i >= initialCount) el.classList.add('blog-item-hidden');
				else el.classList.remove('blog-item-hidden');
			});
			if (loadMoreBtn) loadMoreBtn.style.display = total > initialCount ? '' : 'none';
		}

		sortSelect?.addEventListener('change', (e) => {
			sortItems(e.target.value);
		});

		loadMoreBtn?.addEventListener('click', showNextBatch);
	});
</script>
